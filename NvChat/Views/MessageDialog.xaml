<views:WindowView
    x:Class="NvChat.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:NvChat.Views"
    xmlns:vm="clr-namespace:NvChat.ViewModels"
    mc:Ignorable="d"
    Title="{Binding Title}"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowMinimizeButton="False"
    ShowMaximizeButton="False"
    Style="{StaticResource NvWindowStyle}"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance vm:MessageDialogViewModel}"
    >
    <views:WindowView.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </views:WindowView.InputBindings>

    <StackPanel Margin="22,18,22,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="{StaticResource IconAlert}" Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Top" Margin="0,0,14,0"
                  Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Padding="18,8" Margin="0,0,10,0"
                    Visibility="{Binding IsConfirmation, Converter={StaticResource BoolToVis}}" />
            <!-- 되돌릴 수 없는 동작(삭제 등)은 경고색, 그 외는 액센트 -->
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource DangerButtonStyle}" Padding="22,8" IsDefault="True"
                    Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVis}}" />
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Style="{StaticResource AccentButtonStyle}" Padding="22,8" IsDefault="True"
                    Visibility="{Binding IsDestructive, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>
    </StackPanel>
</views:WindowView>
