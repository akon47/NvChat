<views:WindowView
    x:Class="NvChat.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:NvChat.Views"
    xmlns:vm="clr-namespace:NvChat.ViewModels"
    xmlns:behaviors="clr-namespace:NvChat.Behaviors"
    xmlns:loc="clr-namespace:NvChat.Localization"
    mc:Ignorable="d"
    Title="NvChat"
    ShowTitleText="False"
    Width="1160"
    Height="780"
    MinWidth="520"
    MinHeight="460"
    Style="{StaticResource NvWindowStyle}"
    WindowStartupLocation="CenterScreen"
    behaviors:WindowBehaviors.Placement="{Binding WindowPlacement}"
    behaviors:WindowBehaviors.SavePlacementCommand="{Binding SaveWindowPlacementCommand}"
    behaviors:WindowBehaviors.NarrowBelow="820"
    behaviors:WindowBehaviors.IsNarrow="{Binding IsWindowNarrow}"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    >

    <views:WindowView.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewConversationCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding OpenFindCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Modifiers="Control" Key="M" Command="{Binding ToggleModelPickerCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RegenerateLastCommand}" />
        <KeyBinding Modifiers="Control" Key="E" Command="{Binding ExportConversationCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="C" Command="{Binding CopyConversationCommand}" />
        <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </views:WindowView.InputBindings>

    <!-- ================= 타이틀바: 사이드바 토글 + 모델 선택기 + 설정 ================= -->
    <views:WindowView.TitleBarContent>
        <Grid Margin="4,0,4,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8" ToolTip="{loc:Loc TipSidebarToggle}">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSidebar}" Width="18" Height="18" />
                </Button>

                <!-- 모델 선택기 -->
                <Button x:Name="ModelPickerButton" Command="{Binding ToggleModelPickerCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="10,6" Margin="4,0,0,0" ToolTip="{loc:Loc TipModelPicker}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconChat}" Width="15" Height="15" Margin="0,0,7,0" />
                        <!-- TargetNullValue/FallbackValue 는 바인딩을 받을 수 없으므로, 모델이 없을 때는 트리거로 기본 라벨을 넣는다. -->
                        <TextBlock Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding SelectedModel.Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedModel}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{loc:Loc ModelPickerDefault}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconChevronDown}" Width="13" Height="13" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- 팝업이 열리면 검색 상자에 포커스(IME 포함), Esc 로 닫힘. 항목 클릭(이미 선택된 것 포함)·검색 Enter 로도 닫힌다. -->
                <Popup IsOpen="{Binding IsModelPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ModelPickerButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Focusable="True"
                       behaviors:PopupBehaviors.FocusOnOpen="{Binding ElementName=ModelSearchBox}">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10"
                            Width="440" MaxHeight="500" Margin="6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBox x:Name="ModelSearchBox" Text="{Binding ModelSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:Loc PhModelSearch}" Padding="30,7,10,7"
                                         AutomationProperties.Name="{loc:Loc PhModelSearch}"
                                         behaviors:PopupBehaviors.EnterCommand="{Binding SelectFirstModelCommand}" />
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSearch}" Width="15" Height="15" HorizontalAlignment="Left" Margin="9,0,0,0"
                                      Fill="{DynamicResource MutedForegroundBrush}" IsHitTestVisible="False" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="{loc:Loc ModelPickerDefault}"
                                     behaviors:PopupBehaviors.ClickCommand="{Binding CloseModelPickerCommand}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,8,0,3" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 목록 갱신은 자주 쓰지 않으므로 타이틀바가 아니라 선택기 안에 둔다. -->
                            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="{loc:Loc LoadingModels}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" FontSize="11.5" Margin="8,0,0,0"
                                               Visibility="{Binding IsModelLoading, Converter={StaticResource BoolToVis}}" />
                                    <Button HorizontalAlignment="Right" Command="{Binding RefreshModelsCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8,5" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                                            <TextBlock Text="{loc:Loc TipRefreshModels}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </StackPanel>

            <Button HorizontalAlignment="Right" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="10,6" ToolTip="{loc:Loc TipSettings}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                    <TextBlock Text="{loc:Loc Settings}" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </views:WindowView.TitleBarContent>

    <!-- ================= 본문 ================= -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 좌측 사이드바: 접으면 폭이 0 으로 부드럽게 줄고, 오른쪽 가장자리를 끌어 폭을 바꿀 수 있다 ===== -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True"
                behaviors:LayoutBehaviors.ExpandedWidth="{Binding SidebarWidth}"
                behaviors:LayoutBehaviors.Collapsed="{Binding IsSidebarCollapsed}">
            <!-- 안쪽은 펼친 폭으로 고정해 두어, 접히는 동안 내용이 다시 배치되지 않고 잘려 나가듯 사라진다. -->
            <Grid Width="{Binding SidebarWidth}" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />

                <Button Grid.Row="0" Command="{Binding NewConversationCommand}" Style="{StaticResource AccentButtonStyle}" Margin="12,12,12,6" Padding="12,9" ToolTip="{loc:Loc TipNewChat}"
                        AutomationProperties.Name="{loc:Loc NewChat}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPlus}" Width="15" Height="15" />
                        <TextBlock Text="{loc:Loc NewChat}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Margin="12,4,12,6">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:Loc PhSearchConversations}" FontSize="12.5" Padding="30,6,8,6" ToolTip="{loc:Loc TipSearch}"
                             AutomationProperties.Name="{loc:Loc PhSearchConversations}"
                             behaviors:FocusBehavior.FocusToken="{Binding SearchFocusToken}" behaviors:FocusBehavior.SelectAll="True" />
                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSearch}" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0"
                          Fill="{DynamicResource MutedForegroundBrush}" IsHitTestVisible="False" />
                </Grid>

                <!-- 그룹핑을 쓰면 ListBox 의 가상화가 꺼지므로 명시적으로 켠다(대화가 수백 개여도 보이는 줄만 만든다). -->
                <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding ConversationsView}" SelectedItem="{Binding SelectedConversation}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="{loc:Loc ConversationList}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="14,10,0,3" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConversationViewModel}">
                            <!-- Tag 에 MainViewModel 을 담아 두어 우클릭 메뉴(PlacementTarget.Tag)가 명령에 닿게 한다. -->
                            <Grid x:Name="ConvRow" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.PinConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="{loc:Loc MenuPin}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                            <Setter Property="Header" Value="{loc:Loc MenuUnpin}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="{loc:Loc TipRename}" InputGestureText="F2"
                                                  Command="{Binding PlacementTarget.Tag.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="{loc:Loc Delete}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="DisplayPanel" Grid.Column="0">
                                    <!-- StackPanel 은 자식에게 무한 폭을 주어 TextTrimming 이 동작하지 않으므로 Grid 로 폭을 제한한다. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconPin}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"
                                              Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource ForegroundBrush}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}" />
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock x:Name="ConvSubtitle" Text="{Binding Subtitle}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <!-- 응답 생성 중 표시 -->
                                        <StackPanel x:Name="ConvBusy" Orientation="Horizontal" Visibility="Collapsed">
                                            <Ellipse x:Name="Dot1" Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Opacity="0.3" />
                                            <Ellipse x:Name="Dot2" Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Opacity="0.3" />
                                            <Ellipse x:Name="Dot3" Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Opacity="0.3" />
                                            <TextBlock Text="{loc:Loc Generating}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 인라인 이름 변경: Enter/포커스 잃음 = 확정, Esc = 취소 -->
                                <TextBox x:Name="RenamePanel" Grid.Column="0" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Padding="6,4" FontSize="13"
                                         AutomationProperties.Name="{loc:Loc TipRename}"
                                         behaviors:FocusBehavior.FocusWhenVisible="True" behaviors:FocusBehavior.SelectAll="True"
                                         behaviors:TextBoxCommitBehavior.CommitCommand="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         behaviors:TextBoxCommitBehavior.CancelCommand="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                         behaviors:TextBoxCommitBehavior.CommandParameter="{Binding}" />

                                <!-- 평소엔 자리를 차지하지 않다가 마우스를 올리거나 줄을 고르면 나타난다(키보드로 고른 줄에서도 버튼에 닿을 수 있다). -->
                                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Command="{Binding DataContext.PinConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" ToolTip="{loc:Loc TipPinToggle}">
                                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPin}" Width="14" Height="14" />
                                    </Button>
                                    <Button Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" ToolTip="{loc:Loc TipRename}">
                                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconPencil}" Width="14" Height="14" />
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}" Padding="6" ToolTip="{loc:Loc Delete}">
                                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconDelete}" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ConvRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                    <Setter TargetName="ConvSubtitle" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ConvBusy" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="ConvBusySb" Storyboard="{StaticResource TypingDotsStoryboard}" />
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ConvBusySb" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter TargetName="DisplayPanel" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RenamePanel" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3">
                    <!-- 업데이트 안내. 대화 목록 아래에 두어 채팅을 가리지 않는다. -->
                    <Border Margin="12,6,12,2" Padding="10,8" CornerRadius="8"
                            Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconArrowDown}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Grid.Column="1" Text="{Binding UpdateText}" Foreground="{DynamicResource ForegroundBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Command="{Binding DismissUpdateCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="4" Margin="4,0,0,0" ToolTip="{loc:Loc Later}"
                                        Visibility="{Binding IsUpdateIdle, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" Width="10" Height="10" />
                                </Button>
                            </Grid>

                            <!-- 대기 상태: 설치 버튼 + 무엇이 바뀌었는지 -->
                            <Button Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButtonStyle}" Content="{loc:Loc UpdateNow}"
                                    Padding="0,6" Margin="0,8,0,0" FontSize="12"
                                    Visibility="{Binding IsUpdateIdle, Converter={StaticResource BoolToVis}}" />
                            <Button Command="{Binding OpenReleaseNotesCommand}" Style="{StaticResource SubtleButtonStyle}" Content="{loc:Loc WhatsNew}"
                                    Padding="0,4" Margin="0,4,0,0" FontSize="11.5"
                                    Visibility="{Binding IsUpdateIdle, Converter={StaticResource BoolToVis}}" />

                            <!-- 진행 상태: 진행률 -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Maximum="100" Style="{StaticResource MeterProgressStyle}" />
                                <TextBlock Text="{Binding UpdateProgressText}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="10.5" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 현재 버전. 누르면 수동으로 새 버전을 확인한다. -->
                    <Button Command="{Binding CheckUpdateCommand}" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,6,0,8" Padding="10,3" ToolTip="{loc:Loc TipCheckUpdate}">
                        <TextBlock Text="{Binding AppVersionText}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 우측: 채팅 영역 (이미지 파일을 어디에 놓아도 첨부) ===== -->
        <Grid x:Name="ChatArea" Grid.Column="1" behaviors:InputBehaviors.DropFilesCommand="{Binding AttachFilesCommand}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 헤더: 자주 쓰는 것만 밖에 두고 나머지는 ⋯ 메뉴로 묶는다(삭제 같은 되돌리기 어려운 동작이 다른 아이콘 사이에 섞이지 않게). -->
            <Grid Grid.Row="0" Margin="20,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SelectedConversation.Title}" Foreground="{DynamicResource ForegroundBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding OpenFindCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8" ToolTip="{loc:Loc TipFind}">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSearch}" Width="17" Height="17" />
                    </Button>
                    <Button Command="{Binding ToggleAdvancedCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8" ToolTip="{loc:Loc TipAdvanced}">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconTune}" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource SubtleButtonStyle}" Padding="8" ToolTip="{loc:Loc TipMore}" behaviors:MenuBehaviors.IsDropDown="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc MenuRegenLast}" InputGestureText="Ctrl+R" Command="{Binding RegenerateLastCommand}" />
                                <MenuItem Header="{loc:Loc MenuCopyConversation}" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyConversationCommand}" />
                                <MenuItem Header="{loc:Loc MenuExportMarkdown}" InputGestureText="Ctrl+E" Command="{Binding ExportConversationCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc MenuBackupAll}" Command="{Binding BackupAllCommand}" />
                                <MenuItem Header="{loc:Loc MenuImportBackup}" Command="{Binding ImportBackupCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc MenuClearMessages}" Command="{Binding ClearMessagesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconDotsHorizontal}" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 고급 패널 -->
            <Border Grid.Row="1" Margin="20,4,20,4" Padding="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- 이 대화의 모델별 사용량. 대화 중 모델을 바꾸면 항목이 늘어난다. -->
                    <StackPanel Margin="0,0,0,16" Visibility="{Binding SelectedConversation.HasUsage, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="{loc:Loc ConversationUsage}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedConversation.UsageSummary}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11.5" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SelectedConversation.Usage}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding ShortName}" Foreground="{DynamicResource ForegroundBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelId}" />
                                            <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,0" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc SystemPrompt}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,0,0,5" />
                    <TextBox Text="{Binding SelectedConversation.SystemPrompt, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:Loc PhSystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{loc:Loc SystemPrompt}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Temperature" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="{Binding Value, ElementName=TemperatureSlider, StringFormat=F2}" />
                            </Grid>
                            <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="2" SmallChange="0.01" LargeChange="0.1" Value="{Binding SelectedConversation.Parameters.Temperature, Mode=TwoWay}" Margin="0,0,0,14" AutomationProperties.Name="Temperature" />
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Top P" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="{Binding Value, ElementName=TopPSlider, StringFormat=F2}" />
                            </Grid>
                            <Slider x:Name="TopPSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding SelectedConversation.Parameters.TopP, Mode=TwoWay}" Margin="0,0,0,14" AutomationProperties.Name="Top P" />
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc MaxTokens}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="{Binding Value, ElementName=MaxTokensSlider, StringFormat=N0}" />
                            </Grid>
                            <Slider x:Name="MaxTokensSlider" Minimum="256" Maximum="32768" SmallChange="256" LargeChange="1024" TickFrequency="256" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedConversation.Parameters.MaxTokens, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc MaxTokens}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Frequency Penalty" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="{Binding Value, ElementName=FreqSlider, StringFormat=F2}" />
                            </Grid>
                            <Slider x:Name="FreqSlider" Minimum="-2" Maximum="2" SmallChange="0.01" LargeChange="0.1" Value="{Binding SelectedConversation.Parameters.FrequencyPenalty, Mode=TwoWay}" Margin="0,0,0,14" AutomationProperties.Name="Frequency Penalty" />
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Presence Penalty" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" />
                                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="12" Text="{Binding Value, ElementName=PresSlider, StringFormat=F2}" />
                            </Grid>
                            <Slider x:Name="PresSlider" Minimum="-2" Maximum="2" SmallChange="0.01" LargeChange="0.1" Value="{Binding SelectedConversation.Parameters.PresencePenalty, Mode=TwoWay}" AutomationProperties.Name="Presence Penalty" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 상태 배너(경고/안내). 사용자가 닫을 수 있고, 실패한 요청은 여기서 바로 다시 시도한다. -->
            <Border Grid.Row="2" Margin="20,4,20,4" Padding="12,9" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconAlert}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" />
                    <Button Grid.Column="2" Command="{Binding RetryCommand}" Content="{Binding RetryText}" Padding="12,5" Margin="10,0,0,0" FontSize="12.5"
                            Visibility="{Binding HasRetry, Converter={StaticResource BoolToVis}}" />
                    <Button Grid.Column="3" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SubtleButtonStyle}" Content="{loc:Loc OpenSettings}" Margin="10,0,0,0"
                            Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Grid.Column="4" Command="{Binding DismissStatusCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="6" Margin="6,0,0,0" ToolTip="{loc:Loc TipDismiss}">
                        <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- 메시지 목록 -->
            <Grid Grid.Row="3">
                <ItemsControl x:Name="MessagesList" Style="{StaticResource ChatMessageListStyle}" Padding="20,6,14,6"
                              ItemsSource="{Binding SelectedConversation.Messages}"
                              behaviors:ChatScroll.BringIntoView="{Binding FindCurrent}" />

                <!-- 빈 상태 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="20,0"
                            Visibility="{Binding SelectedConversation.IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Image Source="pack://application:,,,/NvChat;component/Resources/brand.png" Width="60" Height="60" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc EmptyStateTitle}" Foreground="{DynamicResource ForegroundBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="{loc:Loc EmptyStateSubtitle}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />
                    <ItemsControl ItemsSource="{Binding ExamplePrompts}" HorizontalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="5" Padding="14,9" Command="{Binding DataContext.UseExamplePromptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 대화 내 찾기 막대(Ctrl+F) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,26,0" Padding="6" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                        Visibility="{Binding IsFindOpen, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="220" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:Loc PhFind}" FontSize="12.5" Padding="8,5"
                                 AutomationProperties.Name="{loc:Loc PhFind}"
                                 behaviors:FocusBehavior.FocusToken="{Binding FindFocusToken}" behaviors:FocusBehavior.SelectAll="True">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding FindNextCommand}" />
                                <KeyBinding Modifiers="Shift" Key="Enter" Command="{Binding FindPreviousCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CloseFindCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding FindStatus}" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11.5" VerticalAlignment="Center" MinWidth="52" TextAlignment="Center" Margin="6,0,2,0" />
                        <Button Command="{Binding FindPreviousCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="6" ToolTip="{loc:Loc TipFindPrevious}">
                            <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconChevronUp}" Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding FindNextCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="6" ToolTip="{loc:Loc TipFindNext}">
                            <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconChevronDown}" Width="14" Height="14" />
                        </Button>
                        <Button Command="{Binding CloseFindCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="7" ToolTip="{loc:Loc TipDismiss}">
                            <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconClose}" Width="11" Height="11" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 맨 아래로: 목록이 끝에 있지 않을 때만 보인다 -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,10" Width="36" Height="36"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" Foreground="{DynamicResource ForegroundBrush}" ToolTip="{loc:Loc TipScrollBottom}"
                        behaviors:ChatScroll.ScrollToBottomOf="{Binding ElementName=MessagesList}"
                        Visibility="{Binding (behaviors:ChatScroll.IsAtBottom), ElementName=MessagesList, Converter={StaticResource InverseBoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="18">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconArrowDown}" Width="18" Height="18" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 토스트(복사됨·삭제됨 등): 잠깐 떠서 사라진다. 실행 취소 같은 동작 버튼이 붙을 수 있다. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Padding="14,7,8,7" CornerRadius="9" Opacity="0"
                        IsHitTestVisible="{Binding IsToastVisible}"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform Y="8" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="8" Duration="0:0:0.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastText}" Foreground="{DynamicResource ForegroundBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Command="{Binding InvokeToastActionCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="8,3" FontSize="12.5" FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}" Content="{Binding ToastActionText}"
                                Visibility="{Binding HasToastAction, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 컨텍스트 한도로 오래된 메시지를 빼고 보냈을 때의 안내 -->
            <TextBlock Grid.Row="4" Margin="24,2,24,0" MaxWidth="{StaticResource ConversationColumnWidth}" Text="{Binding SelectedConversation.ContextNote}"
                       Foreground="{DynamicResource MutedForegroundBrush}" FontSize="11.5" TextWrapping="Wrap"
                       Visibility="{Binding SelectedConversation.HasContextNote, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <!-- ===== 입력 (상단 텍스트 + 하단 툴바) ===== -->
            <Border Grid.Row="5" Margin="20,6,20,16" Padding="12,10,10,8" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"
                    MaxWidth="{StaticResource ConversationColumnWidth}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Loc PhMessageInput}" Background="Transparent" BorderThickness="0" Padding="2,2,2,4" FontSize="{StaticResource BodyFontSize}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{loc:Loc MessageInput}"
                             behaviors:FocusBehavior.FocusWhenVisible="True"
                             behaviors:FocusBehavior.FocusToken="{Binding InputFocusToken}"
                             behaviors:InputBehaviors.SendCommand="{Binding SendCommand}"
                             behaviors:InputBehaviors.SendOnEnter="{Binding SendOnEnter}"
                             behaviors:InputBehaviors.PasteImageCommand="{Binding PasteImageCommand}" />

                    <!-- 첨부 미리보기 -->
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,2" Focusable="False" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,4" Width="60" Height="60">
                                    <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}" Foreground="White" Background="#B0000000" Width="18" Height="18" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" ToolTip="{loc:Loc Remove}">
                                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform" Fill="White" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 툴바 행 -->
                    <Grid Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding AttachImageCommand}" Style="{StaticResource SubtleButtonStyle}" Padding="7" ToolTip="{loc:Loc TipAttachImage}">
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconAttach}" Width="19" Height="19" />
                            </Button>
                            <!-- 프리셋 드롭다운: 설정의 프리셋 목록을 메뉴로 띄워 입력창에 삽입 -->
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,6" ToolTip="{loc:Loc TipPresets}"
                                    behaviors:MenuBehaviors.IsDropDown="True" behaviors:MenuBehaviors.DropDownPlacement="Top">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding PresetMenu}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                <Setter Property="Command" Value="{Binding DataContext.InsertPresetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Setter Property="CommandParameter" Value="{Binding Preset}" />
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconBookmark}" Width="15" Height="15" />
                                    <TextBlock Text="{loc:Loc Presets}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" Command="{Binding SendCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,7"
                                Visibility="{Binding IsSelectedStreaming, Converter={StaticResource InverseBoolToVis}}" ToolTip="{loc:Loc Send}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Send}" VerticalAlignment="Center" />
                                <Path Style="{StaticResource IconStyle}" Data="{StaticResource IconSend}" Width="15" Height="15" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Right" Command="{Binding StopCommand}" Padding="14,7"
                                Visibility="{Binding IsSelectedStreaming, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Loc TipStop}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStop}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Stop}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 파일을 끌어 올렸을 때: 놓을 수 있는 자리임을 알린다 -->
            <Border Grid.RowSpan="6" Margin="12" CornerRadius="14" IsHitTestVisible="False" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (behaviors:InputBehaviors.IsFileDragOver), ElementName=ChatArea}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconImage}" Width="44" Height="44" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Loc DropImagesHere}" Foreground="{DynamicResource ForegroundBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 사이드바와 채팅 영역의 경계를 끌어 사이드바 폭 조절. 사이드바 안이 아니라 경계 바로 오른쪽에 두어 대화 목록의 스크롤 막대를 가리지 않는다. -->
        <Thumb Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource EdgeResizeThumbStyle}"
               AutomationProperties.Name="{loc:Loc TipResizeSidebar}" ToolTip="{loc:Loc TipResizeSidebar}"
               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"
               behaviors:LayoutBehaviors.ResizeWidth="{Binding SidebarWidth}"
               behaviors:LayoutBehaviors.ResizeMin="220" behaviors:LayoutBehaviors.ResizeMax="460" />
    </Grid>
</views:WindowView>
