<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <!-- 고대비 팔레트(검정 바탕 · 흰 글자 · 노랑 강조). 윈도우 고대비 모드에서 자동 선택된다. -->
    <Color x:Key="WindowBackgroundColor">#000000</Color>
    <Color x:Key="TitleBarBackgroundColor">#000000</Color>
    <Color x:Key="PanelBackgroundColor">#000000</Color>
    <Color x:Key="CardBackgroundColor">#000000</Color>
    <Color x:Key="ControlBackgroundColor">#000000</Color>
    <Color x:Key="ControlHoverBackgroundColor">#262626</Color>
    <Color x:Key="ForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="MutedForegroundColor">#D0D0D0</Color>
    <Color x:Key="BorderColor">#FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#FFFF00</Color>
    <Color x:Key="AccentHoverColor">#FFFF7A</Color>
    <Color x:Key="AccentPressedColor">#CCCC00</Color>
    <Color x:Key="AccentForegroundColor">#000000</Color>
    <Color x:Key="UserBubbleBackgroundColor">#000000</Color>
    <Color x:Key="UserBubbleBorderColor">#FFFF00</Color>
    <Color x:Key="CodeBlockBackgroundColor">#000000</Color>
    <Color x:Key="CodeHeaderBackgroundColor">#1F1F1F</Color>
    <Color x:Key="CodeForegroundColor">#FFFFFF</Color>
    <Color x:Key="InlineCodeBackgroundColor">#1F1F1F</Color>
    <Color x:Key="InlineCodeForegroundColor">#FFFF00</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <Color x:Key="SuccessColor">#3FF23F</Color>
    <Color x:Key="WarnColor">#FFD400</Color>
    <Color x:Key="ScrollThumbColor">#FFFFFF</Color>
    <Color x:Key="ScrollThumbHoverColor">#FFFF00</Color>
    <Color x:Key="OverlayColor">#FFFFFF</Color>
    <Color x:Key="CloseHoverColor">#FF0000</Color>
    <Color x:Key="FindHighlightColor">#8A4B00</Color>
    <Color x:Key="SyntaxKeywordColor">#5CC8FF</Color>
    <Color x:Key="SyntaxStringColor">#FFB86B</Color>
    <Color x:Key="SyntaxCommentColor">#7CFC7C</Color>
    <Color x:Key="SyntaxNumberColor">#B5F5A8</Color>
</ResourceDictionary>
