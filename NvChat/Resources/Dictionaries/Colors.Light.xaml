<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <!-- 밝은 팔레트. 키는 Colors.xaml 과 정확히 같아야 한다(ThemeManager 가 키로 브러시를 다시 만든다). -->
    <Color x:Key="WindowBackgroundColor">#FAFAFB</Color>
    <Color x:Key="TitleBarBackgroundColor">#F1F1F3</Color>
    <Color x:Key="PanelBackgroundColor">#F4F4F6</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ControlHoverBackgroundColor">#ECECEF</Color>
    <Color x:Key="ForegroundColor">#1B1B1F</Color>
    <Color x:Key="SecondaryForegroundColor">#55585F</Color>
    <Color x:Key="MutedForegroundColor">#7C7F87</Color>
    <Color x:Key="BorderColor">#DFDFE4</Color>
    <Color x:Key="BorderStrongColor">#C4C4CB</Color>
    <Color x:Key="AccentColor">#4F8000</Color>
    <Color x:Key="AccentHoverColor">#5E9400</Color>
    <Color x:Key="AccentPressedColor">#416A00</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="UserBubbleBackgroundColor">#EAF4D9</Color>
    <Color x:Key="UserBubbleBorderColor">#CFE3A6</Color>
    <Color x:Key="CodeBlockBackgroundColor">#F6F6F8</Color>
    <Color x:Key="CodeHeaderBackgroundColor">#EAEAEE</Color>
    <Color x:Key="CodeForegroundColor">#24262B</Color>
    <Color x:Key="InlineCodeBackgroundColor">#EAEAEE</Color>
    <Color x:Key="InlineCodeForegroundColor">#3F6B00</Color>
    <Color x:Key="ErrorColor">#D1372F</Color>
    <Color x:Key="SuccessColor">#2E8B32</Color>
    <Color x:Key="WarnColor">#B26A00</Color>
    <Color x:Key="ScrollThumbColor">#C4C4CA</Color>
    <Color x:Key="ScrollThumbHoverColor">#A3A3AC</Color>
    <Color x:Key="OverlayColor">#000000</Color>
    <Color x:Key="CloseHoverColor">#E5534B</Color>
    <Color x:Key="FindHighlightColor">#FFE58A</Color>
    <Color x:Key="SyntaxKeywordColor">#0000FF</Color>
    <Color x:Key="SyntaxStringColor">#A31515</Color>
    <Color x:Key="SyntaxCommentColor">#008000</Color>
    <Color x:Key="SyntaxNumberColor">#098658</Color>
</ResourceDictionary>
